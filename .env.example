# Copy to .env for local runs of scripts/sync.js (do NOT commit).
# In production these live in GitHub → Settings → Secrets → Actions.
SUPABASE_URL=https://kdysjiiefvxnkrykgykz.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
GAS_URL=https://script.google.com/macros/s/<deployment-id>/exec
GAS_SYNC_KEY=<output of generateSyncKey() in Apps Script>

# Edge Function secrets (set with `supabase secrets set NAME=value`):
#   DEFAULT_OWNER_USERNAME   default: admin
#   DEFAULT_OWNER_PASSWORD   default: abhyas   (change forced at first login)
#   FILE_LEGACY_CONTENT      set to false once every client reads `result`
#   ALLOWED_ORIGINS, CONTENT_KEY_ID, CONTENT_KEY_<id>, GOOGLE_CLIENT_ID
# Apps Script → Project Settings → Script Properties:
#   SYNC_KEY, SUPABASE_SERVICE_ROLE_KEY, (optional) SUPABASE_URL
